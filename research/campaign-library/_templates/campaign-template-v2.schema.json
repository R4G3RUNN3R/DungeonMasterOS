{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dungeonmaster-os.com/schemas/campaign-template-v2.schema.json",
  "title": "DungeonMasterOS Campaign Template v2",
  "type": "object",
  "required": ["id", "title", "status", "rules", "source", "playerMetadata", "canon", "locations", "npcs", "scenes", "endings"],
  "properties": {
    "id": {"type": "string", "minLength": 1},
    "title": {"type": "string", "minLength": 1},
    "version": {"type": "string"},
    "status": {"enum": ["draft", "researching", "extracted", "templated", "qa", "approved", "private-import", "metadata-only", "rejected"]},
    "rules": {
      "type": "object",
      "required": ["nativeRuleset", "nativeEdition", "progressionModel", "supportedRulesets"],
      "properties": {
        "nativeRuleset": {"type": "string"},
        "nativeEdition": {"type": ["string", "null"]},
        "rulesFamily": {"type": ["string", "null"]},
        "progressionModel": {"enum": ["levels", "xp", "ranks", "advances", "dots", "narrative", "none", "system-specific"]},
        "startingProgression": {"type": ["string", "number", "null"]},
        "endingProgression": {"type": ["string", "number", "null"]},
        "recommendedGroupMin": {"type": ["integer", "null"], "minimum": 1},
        "recommendedGroupMax": {"type": ["integer", "null"], "minimum": 1},
        "estimatedHoursMin": {"type": ["number", "null"], "minimum": 0},
        "estimatedHoursMax": {"type": ["number", "null"], "minimum": 0},
        "supportedRulesets": {
          "type": "array",
          "minItems": 1,
          "items": {"$ref": "#/$defs/rulesetSupport"}
        }
      }
    },
    "source": {
      "type": "object",
      "required": ["kind", "title", "primaryUrl", "licence", "disposition"],
      "properties": {
        "kind": {"enum": ["open-licensed", "public-domain", "official-commercial", "community-commercial", "third-party", "unknown"]},
        "title": {"type": "string"},
        "author": {"type": ["string", "null"]},
        "publisher": {"type": ["string", "null"]},
        "primaryUrl": {"type": "string"},
        "sourceIcon": {"type": ["string", "null"]},
        "licence": {"type": "string"},
        "licenceUrl": {"type": ["string", "null"]},
        "adaptationAllowed": {"type": ["boolean", "null"]},
        "commercialUseAllowed": {"type": ["boolean", "null"]},
        "redistributionAllowed": {"type": ["boolean", "null"]},
        "shareAlike": {"type": ["boolean", "null"]},
        "attributionText": {"type": ["string", "null"]},
        "disposition": {"enum": ["built-in", "private-import", "metadata-only", "pending", "rejected"]},
        "verifiedAt": {"type": ["string", "null"]}
      }
    },
    "playerMetadata": {
      "type": "object",
      "required": ["pitch", "genres"],
      "properties": {
        "pitch": {"type": "string"},
        "genres": {"type": "array", "items": {"type": "string"}},
        "themes": {"type": "array", "items": {"type": "string"}},
        "tone": {"type": "array", "items": {"type": "string"}},
        "setting": {"type": ["string", "null"]},
        "structure": {"enum": ["linear", "branching", "sandbox", "hybrid", "scenario", "chronicle"]},
        "contentWarnings": {"type": "array", "items": {"type": "string"}}
      }
    },
    "canon": {
      "type": "object",
      "required": ["hard", "conditional", "soft", "freeImprovisation"],
      "properties": {
        "hard": {"type": "array", "items": {"$ref": "#/$defs/canonRule"}},
        "conditional": {"type": "array", "items": {"$ref": "#/$defs/conditionalCanonRule"}},
        "soft": {"type": "array", "items": {"$ref": "#/$defs/canonRule"}},
        "freeImprovisation": {"type": "array", "items": {"$ref": "#/$defs/canonRule"}}
      }
    },
    "locations": {"type": "array", "items": {"$ref": "#/$defs/location"}},
    "npcs": {"type": "array", "items": {"$ref": "#/$defs/npc"}},
    "factions": {"type": "array", "items": {"$ref": "#/$defs/faction"}},
    "items": {"type": "array", "items": {"type": "object"}},
    "clocks": {"type": "array", "items": {"$ref": "#/$defs/clock"}},
    "scenes": {"type": "array", "items": {"$ref": "#/$defs/scene"}},
    "endings": {"type": "array", "items": {"$ref": "#/$defs/ending"}},
    "communityIntelligence": {"type": "array", "items": {"type": "object"}},
    "adaptationNotes": {"type": "array", "items": {"type": "string"}},
    "researchSources": {"type": "array", "items": {"type": "object"}}
  },
  "$defs": {
    "rulesetSupport": {
      "type": "object",
      "required": ["ruleset", "supportLevel"],
      "properties": {
        "ruleset": {"type": "string"},
        "edition": {"type": ["string", "null"]},
        "supportLevel": {"enum": ["native", "direct-compatible", "system-agnostic", "converted", "tested", "private-import-only"]},
        "progressionRecommendation": {"type": ["string", "null"]},
        "groupRecommendation": {"type": ["string", "null"]},
        "conversionNotes": {"type": ["string", "null"]},
        "validationSource": {"type": ["string", "null"]}
      }
    },
    "canonRule": {
      "type": "object",
      "required": ["id", "rule"],
      "properties": {
        "id": {"type": "string"},
        "rule": {"type": "string"},
        "sourceRef": {"type": ["string", "null"]}
      }
    },
    "conditionalCanonRule": {
      "type": "object",
      "required": ["id", "rule", "condition"],
      "properties": {
        "id": {"type": "string"},
        "rule": {"type": "string"},
        "condition": {"$ref": "#/$defs/condition"},
        "sourceRef": {"type": ["string", "null"]}
      }
    },
    "condition": {
      "type": "object",
      "required": ["type"],
      "properties": {
        "type": {"enum": ["flag", "not-flag", "location", "has-item", "npc-state", "faction-state", "scene-complete", "progression", "clock", "custom"]},
        "key": {"type": ["string", "null"]},
        "operator": {"type": ["string", "null"]},
        "value": {}
      }
    },
    "location": {
      "type": "object",
      "required": ["id", "name"],
      "properties": {
        "id": {"type": "string"},
        "name": {"type": "string"},
        "type": {"type": ["string", "null"]},
        "parentId": {"type": ["string", "null"]},
        "description": {"type": ["string", "null"]},
        "connections": {"type": "array", "items": {"type": "string"}},
        "secrets": {"type": "array", "items": {"type": "string"}},
        "sourceRefs": {"type": "array", "items": {"type": "string"}}
      }
    },
    "npc": {
      "type": "object",
      "required": ["id", "name", "role"],
      "properties": {
        "id": {"type": "string"},
        "name": {"type": "string"},
        "role": {"type": "string"},
        "locationId": {"type": ["string", "null"]},
        "factionId": {"type": ["string", "null"]},
        "publicGoal": {"type": ["string", "null"]},
        "privateGoal": {"type": ["string", "null"]},
        "knowledge": {"type": "array", "items": {"type": "string"}},
        "secrets": {"type": "array", "items": {"type": "string"}},
        "sourceRefs": {"type": "array", "items": {"type": "string"}}
      }
    },
    "faction": {
      "type": "object",
      "required": ["id", "name"],
      "properties": {
        "id": {"type": "string"},
        "name": {"type": "string"},
        "goals": {"type": "array", "items": {"type": "string"}},
        "sourceRefs": {"type": "array", "items": {"type": "string"}}
      }
    },
    "clock": {
      "type": "object",
      "required": ["id", "name", "segments"],
      "properties": {
        "id": {"type": "string"},
        "name": {"type": "string"},
        "segments": {"type": "integer", "minimum": 1},
        "current": {"type": "integer", "minimum": 0},
        "advanceRule": {"type": ["string", "null"]},
        "effects": {"type": "array", "items": {"type": "string"}}
      }
    },
    "scene": {
      "type": "object",
      "required": ["id", "title", "requiredFacts", "choices", "freeTextPolicy"],
      "properties": {
        "id": {"type": "string"},
        "title": {"type": "string"},
        "locationId": {"type": ["string", "null"]},
        "entryConditions": {"type": "array", "items": {"$ref": "#/$defs/condition"}},
        "requiredFacts": {"type": "array", "items": {"type": "string"}},
        "hiddenFacts": {"type": "array", "items": {"type": "string"}},
        "choices": {"type": "array", "minItems": 0, "maxItems": 8, "items": {"type": "object"}},
        "suggestedChoiceCount": {"type": "integer", "minimum": 3, "maximum": 5},
        "freeTextPolicy": {
          "type": "object",
          "required": ["allowed", "mustPreserveHardCanon"],
          "properties": {
            "allowed": {"const": true},
            "mustPreserveHardCanon": {"const": true},
            "adjudicationRule": {"type": "string"},
            "mayCreateMinorDetails": {"type": "boolean"},
            "mayCreateMajorLocations": {"type": "boolean", "default": false},
            "mayCreateMajorNpcs": {"type": "boolean", "default": false}
          }
        },
        "sourceRefs": {"type": "array", "items": {"type": "string"}}
      }
    },
    "ending": {
      "type": "object",
      "required": ["id", "title", "summary"],
      "properties": {
        "id": {"type": "string"},
        "title": {"type": "string"},
        "conditions": {"type": "array", "items": {"$ref": "#/$defs/condition"}},
        "summary": {"type": "string"},
        "sourceRefs": {"type": "array", "items": {"type": "string"}}
      }
    }
  }
}

# DungeonMasterOS environment template. Never commit real credentials.
NODE_ENV=production
HOST=127.0.0.1
PORT=5000
APP_URL=https://your-domain.example
APP_BASE_PATH=
DATABASE_URL=/srv/dmos/shared/data.db

# Session security
JWT_SECRET=replace-with-a-long-random-secret
COOKIE_SECURE=true
COOKIE_DOMAIN=

# Google OAuth. Keep these configured for existing Google-linked accounts.
GOOGLE_CLIENT_ID=replace-with-google-client-id
GOOGLE_CLIENT_SECRET=replace-with-google-client-secret
GOOGLE_OAUTH_REDIRECT_URL=https://your-domain.example/api/auth/google/callback

# Anthropic
ANTHROPIC_API_KEY=replace-with-anthropic-api-key
ANTHROPIC_MODEL=
ANTHROPIC_FALLBACK_MODELS=
ANTHROPIC_TIMEOUT_MS=
ANTHROPIC_RETRY_ATTEMPTS=
ANTHROPIC_RETRY_BASE_MS=

# Stripe
STRIPE_SECRET_KEY=replace-with-stripe-secret-key
STRIPE_WEBHOOK_SECRET=replace-with-stripe-webhook-secret
STRIPE_PRICE_ADVENTURER_WEEKLY=
STRIPE_PRICE_ADVENTURER_MONTHLY=
STRIPE_PRICE_ADVENTURER_YEARLY=
STRIPE_PRICE_MASTER_WEEKLY=
STRIPE_PRICE_MASTER_MONTHLY=
STRIPE_PRICE_MASTER_YEARLY=
STRIPE_PRICE_LEGEND_WEEKLY=
STRIPE_PRICE_LEGEND_MONTHLY=
STRIPE_PRICE_LEGEND_YEARLY=
